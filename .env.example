# Host path to Codex config (default: ~/.codex)

# For Docker workers: pass into containers via scripts/docker-workers.sh (--env-file .env)
# OPENAI_API_KEY=sk-...

# Optional: override coder sandbox flags (host env before running the script)
# CODEX_FLAGS_CODER="--dangerously-bypass-approvals-and-sandbox"

# Optional: coder /workspace Docker volume name (scripts/docker-workers.sh)
# SWARM_CODER_WORKSPACE_VOLUME=swarm-coder-workspace
